// Swweeep 36-key + 2 encoders — Strategy A (0% Rolling, Hold-and-Release Hub-and-Spoke)
// Tuned for EndeavourOS tiling WM (Win+HJKL, Win+1..9, Win+Shift+1..9)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define CODE    1
#define NAV     2
#define FUNC    3
#define SET     4

&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Hold CODE + NAV (adjacent right thumbs) -> Function & Media
        tri_func {
            if-layers = <CODE NAV>;
            then-layer = <FUNC>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // --- Preserved Original Combos (25ms window for 70-100 WPM) ---
        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>; // Q + W
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        combo_backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <12 13>; // D + F
            timeout-ms = <25>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17>; // J + K
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        combo_home {
            bindings = <&kp HOME>;
            key-positions = <10 11>; // A + S
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        combo_end {
            bindings = <&kp END>;
            key-positions = <18 19>; // L + ;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        combo_alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <20 21>; // Z + X
            timeout-ms = <25>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        combo_ctrl_backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <22 23>; // C + V
            timeout-ms = <25>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        combo_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <27 28>; // , + .
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <DEFAULT CODE NAV FUNC>;
        };

        // --- Non-Rolling Utility Combos ---
        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 2>; // Q + E (non-adjacent)
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
            layers = <DEFAULT CODE>;
        };

        combo_caps_word {
            bindings = <&caps_word>;
            key-positions = <14 15>; // G + H (cross-hand)
            timeout-ms = <30>;
            require-prior-idle-ms = <100>;
            layers = <DEFAULT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp Q  &kp W             &kp E      &kp R       &kp T       &kp Y      &kp U     &kp I      &kp O    &kp P
&kp A  &kp S             &kp D      &kp F       &kp G       &kp H      &kp J     &kp K      &kp L    &kp SEMICOLON
&kp Z  &kp X             &kp C      &kp V       &kp B       &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH
       &kp C_PLAY_PAUSE  &kp LCTRL  &kp LGUI    &kp LSHIFT  &kp SPACE  &mo CODE  &mo NAV    &kp C_MUTE
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        code_layer {
            display-name = "Code";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6      &kp NUMBER_7          &kp NUMBER_8           &kp NUMBER_9       &kp NUMBER_0
&kp TAB       &kp EQUAL     &kp PLUS      &kp MINUS     &kp UNDERSCORE  &kp LEFT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE    &kp ENTER
&kp LALT      &kp GRAVE     &kp TILDE     &kp PIPE      &kp BACKSLASH   &kp LEFT_BRACKET  &kp DOUBLE_QUOTES     &kp SINGLE_QUOTE       &kp RIGHT_BRACKET  &kp BACKSPACE
              &trans        &trans        &trans        &trans          &trans            &trans                &trans                 &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LC(EQUAL) LC(MINUS)>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        nav_layer {
            display-name = "Navigation";
            bindings = <
&kp ESCAPE  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &mkp RCLK    &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&kp TAB     &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &mkp LCLK    &kp LEFT   &kp DOWN        &kp UP_ARROW    &kp RIGHT     &kp PG_UP
&kp LALT    &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &mkp MCLK    &kp TAB    &msc SCRL_DOWN  &msc SCRL_UP    &kp DELETE    &kp PG_DN
            &trans      &trans      &trans      &trans       &trans     &trans          &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LC(LG(RIGHT)) LC(LG(LEFT))>,
                <&inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        function_layer {
            display-name = "Function_&_Media";
            bindings = <
&kp ESCAPE  &kp C_BRIGHTNESS_DEC  &kp PRINTSCREEN   &kp C_BRIGHTNESS_INC  &kp CAPS  &kp F9  &kp F10  &kp F11  &kp F12  &kp BACKSPACE
&kp TAB     &kp C_PREVIOUS        &kp C_PLAY_PAUSE  &kp C_NEXT            &none     &kp F5  &kp F6   &kp F7   &kp F8   &kp ENTER
&kp LALT    &kp C_VOL_DN          &kp C_MUTE        &kp C_VOL_UP          &mo SET   &kp F1  &kp F2   &kp F3   &kp F4   &none
            &trans                &trans            &trans                &trans    &trans  &trans   &trans   &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };

        settings_layer {
            display-name = "Settings";
            bindings = <
&kp ESCAPE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR      &bt BT_SEL 3  &bt BT_SEL 4  &none           &none       &none
&kp TAB     &none         &bt BT_NXT    &bt BT_PRV    &bt BT_CLR_ALL  &none         &bootloader   &studio_unlock  &sys_reset  &none
&none       &none         &out OUT_BLE  &out OUT_USB  &trans          &none         &none         &none           &none       &none
            &trans        &trans        &trans        &trans          &trans        &trans        &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREVIOUS>;
        };
    };
};
